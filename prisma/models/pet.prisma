enum PetStatus {
  HOME
  LOST
}

enum PetSex {
  MALE
  FEMALE
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  OTHER
}

model Pet {
  id  Int @id @default(autoincrement())
  name String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId Int
  photos PetPhoto[]
  status PetStatus @default(HOME)
  publicCode String @unique
  rewardAmount Decimal? @db.Decimal(10, 2)
  species PetSpecies?
  color String?
  sex PetSex?
  birthDate DateTime?
  traits String? // особые приметы: шрамы, повадки, ошейник — помогают опознать
  weightKg Float?
  hasMicrochip Boolean? // null = не указано; отличается от «чипа нет»

  lostEpisodes LostEpisode[]
  sightings Sighting[]

  @@index([status])
  @@map("pets")
}

model PetPhoto {
  id Int @id @default(autoincrement())
  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
  petId Int
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId Int @unique
  position Int @default(0)

  @@map("pet_photos")
}

model LostEpisode {
  id Int @id @default(autoincrement())
  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
  petId Int
  lostAt DateTime @default(now())
  foundAt DateTime?
  // место пропажи — опционально: владелец часто не знает, где именно потерялся питомец
  lat Float?
  lng Float?
  address String?
  // телефоны для этого объявления; пустой список = звонить владельцу (user.phone)
  contactPhones String[]

  @@index([petId, lostAt])
  // публичная лента: активные эпизоды от свежих к старым
  @@index([foundAt, lostAt])
  // гео-фильтр ленты по bounding box места пропажи
  @@index([lat, lng])
  @@map("lost_episodes")
}

model Sighting {
  id Int @id @default(autoincrement())
  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
  petId Int
  lat Float?
  lng Float?
  address String?
  comment String?
  reporterPhone String?
  photo File? @relation(fields: [photoFileId], references: [id], onDelete: SetNull)
  photoFileId Int? @unique
  createdAt DateTime @default(now())

  @@index([petId, createdAt])
  @@map("sightings")
}
